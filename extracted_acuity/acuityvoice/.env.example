# AssemblyAI API Key (Set this in your local .env file)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Mode: Set to true to test without burning any API credit
MOCK_MODE=false

# Session Safety Max Duration in Seconds (Default: 180s = 3 minutes max per interview)
MAX_SESSION_SECONDS=180

# Port configuration
PORT=8000
